ANTHROPIC_API_KEY=your_key_here
PORT=8787

# Frontend → backend base URL (build-time, Vite). Leave empty for local dev
# and single-host deploys (same-origin). On Vercel set this to the public URL
# of the Node backend, e.g. https://batsbettor-api.up.railway.app
VITE_API_URL=

# The Odds API (optional — odds and model features are skipped without it)
ODDS_API_KEY=
ODDS_API_REGION=us
ODDS_API_BOOKMAKER=

# Supabase (optional — snapshot ingestion is skipped without it)
# Run server/db/schema.sql in the Supabase SQL editor once.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
